{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ok-sessions-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "api.olliekav.com", "custom_domain": true }],
  "observability": { "enabled": true },
  "vars": {
    "MEDIA_BASE_URL": "https://media.olliekav.com",
    "SITE_URL": "https://dj.olliekav.com",
    "ALLOWED_ORIGINS": "https://dj.olliekav.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ok-sessions",
      // Replace with the id printed by `wrangler d1 create ok-sessions`
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "EVENTS_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  // Prune de-duplication rows daily
  "triggers": { "crons": ["17 3 * * *"] }
  // Secrets (wrangler secret put): ADMIN_TOKEN
}
